{
  "name": "@duraverso/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3107",
    "build": "tsx src/db/migrate-deploy.ts && next build",
    "start": "next start --hostname 127.0.0.1 --port 3107",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs --falsify",
    "catalog:plan": "tsx src/db/catalog-plan.ts",
    "catalog:import": "tsx src/db/catalog-import.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@duraverso/core": "workspace:*",
    "@neondatabase/serverless": "1.2.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
