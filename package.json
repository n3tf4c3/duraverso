{
  "name": "duraverso",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "web": "pnpm --filter @duraverso/web dev",
    "web:build": "pnpm --filter @duraverso/web build",
    "web:start": "pnpm --filter @duraverso/web start",
    "catalog:plan": "pnpm --filter @duraverso/web catalog:plan",
    "catalog:import": "pnpm --filter @duraverso/web catalog:import",
    "lint": "prettier --check . && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @duraverso/web test:integration",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
